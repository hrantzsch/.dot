[user]
    email = mail@hannesrantzsch.de
    name = Hannes Rantzsch
[push]
    default = simple
[pull]
    rebase = true
[core]
    editor = nvim
[diff]
    tool = nvimdiff
[difftool "vimdiff"]
    path = nvim
[merge]
    tool = nvimdiff
    conflictstyle = diff3
[mergetool]
    path = nvim
[init]
    defaultBranch = main
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[credential]
    helper = cache --timeout 604800
