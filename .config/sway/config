#
# --- globals ---
#

set $mod Mod4

set $term foot
set $edit nvim
set $notify notify-send

include /etc/sway/config.d/*

output eDP-1 mode 3840x2160 scale 1.25
output HDMI-A-1 enable scale 1.5

input type:keyboard {
  repeat_delay 200
  repeat_rate 30
  xkb_layout us,de
  xkb_options grp:switch,caps:escape
}

workspace_layout default
workspace_auto_back_and_forth yes

set $lock_cmd "swaylock -f -c 338066"

exec swayidle -w \
         timeout 300 '$lock_cmd' \
         timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
         before-sleep '$lock_cmd'

exec mako

# workspace names
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9

#
# --- appearance ---
#

default_border pixel 6
default_floating_border pixel 6
hide_edge_borders none

font pango:Fantasque Sans Mono 12

set $darkgray   #26233a
set $gray       #6e6a86
set $red        #eb6f92
set $blue       #31748f
set $yellow     #f6c177
set $cyan       #9ccfd8
set $magenta    #c4a7e7
set $rose       #ebbcba
set $white      #e0def4
set $bg         #26233a

# class                 border    backgr.   text      indicator child_border
client.focused          $rose     $rose     $darkgray $rose     $blue
client.focused_inactive $darkgray $darkgray $yellow   $darkgray $darkgray
client.unfocused        $darkgray $darkgray $yellow   $darkgray $darkgray
client.urgent           $magenta  $magenta  $bg       $darkgray $magenta

#
# --- bar ---
#

bar {
    position                top
    tray_padding            0
    status_command          i3status-rs ~/.config/i3/i3statusrs_config.toml
    tray_output             *
    strip_workspace_numbers yes
    workspace_buttons       yes

    colors {
        background $bg
        statusline $gray

#                           box       bg          fg
        focused_workspace   $gray     $darkgray   $magenta
        active_workspace    $bg       $darkgray   $magenta
        inactive_workspace  $bg       $darkgray   $gray
        urgent_workspace    $magenta  $darkgray   $rose
        binding_mode        $magenta  $darkgray   $rose
    }
}

#
# --- application shortcuts ---
#

bindsym $mod+Return exec $term

bindsym $mod+Shift+q kill
bindsym $mod+Ctrl+x --release exec --no-startup-id xkill

# rofi & friends
set $rofi_config ~/.config/rofi/moon.rasi
bindsym $mod+space           exec "rofi -show combi -modi combi -combi-modi drun,run -config $rofi_config "
bindsym $mod+o               exec "rofi -show filebrowser -modi filebrowser -config $rofi_config"
bindsym $mod+t               exec "rofi -show window -config $rofi_config"
bindsym $mod+Shift+e         exec ~/.config/i3/scripts/powermenu

bindsym $mod+p               exec rofi-pass
bindsym $mod+i               exec rofimoji
bindsym $mod+v               exec EDITOR=$edit $term vimclip
bindsym Control+Shift+Escape exec $term htop

set $notes_home "$HOME/Nextcloud/Notes"
bindsym $mod+n       exec $term $edit -c "lcd "$notes_home $notes_home
bindsym $mod+m       exec $term $edit -c "lcd "$notes_home $notes_home"/personal-notes.md"
bindsym $mod+z       exec $term --title zettelkasten -- $notes_home"/Zettel/new_zettel.sh" $notes_home
bindsym $mod+Shift+z exec $term --title zettelkasten -- "$HOME/bin/lzt"

bindsym XF86MonBrightnessUp   exec xbacklight +20
bindsym XF86MonBrightnessDown exec xbacklight -20

bindsym XF86AudioRaiseVolume exec amixer -D pulse sset Master 5%+
bindsym XF86AudioLowerVolume exec amixer -D pulse sset Master 5%-
bindsym XF86AudioMute exec amixer sset Master toggle

# volume
#bindsym XF86AudioRaiseVolume exec amixer -D pulse sset Master 5%+ # && pkill -RTMIN+1 i3blocks
#bindsym XF86AudioLowerVolume exec amixer -D pulse sset Master 5%- # && pkill -RTMIN+1 i3blocks
#bindsym XF86AudioMute exec amixer sset Master toggle && killall -USR1 i3blocks
# gradular volume control
#bindsym $mod+XF86AudioRaiseVolume exec amixer -D pulse sset Master 1%+ && pkill -RTMIN+1 i3blocks
#bindsym $mod+XF86AudioLowerVolume exec amixer -D pulse sset Master 1%- && pkill -RTMIN+1 i3blocks

bindsym XF86AudioPlay exec playerctl play
bindsym XF86AudioPause exec playerctl pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

#
# --- workspace assigned windows ---
#

# bind program to workspace and focus to them on startup:
assign [class="(?i)firefox"] $ws2
assign [class="(?i)slack"] $ws8
assign [class="(?i)signal"] $ws9

# automatic set focus new window if it opens on another workspace then the current:
for_window [class=(?i)firefox] focus
for_window [class=(?i)slack] focus
for_window [class=(?i)signal] focus

#
# --- floating windows ---
#

for_window [title="alsamixer"] floating enable border pixel 1
for_window [class="Pavucontrol"] floating enable
for_window [class="Gnome-calculator"] floating enable

floating_modifier $mod normal

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Ctrl+h move workspace to output left
bindsym $mod+Ctrl+j move workspace to output down
bindsym $mod+Ctrl+k move workspace to output up
bindsym $mod+Ctrl+l move workspace to output right

bindsym $mod+b workspace back_and_forth
bindsym $mod+Shift+b move container to workspace back_and_forth; workspace back_and_forth

bindsym $mod+Tab split toggle
bindsym $mod+a   focus parent

bindsym $mod+s layout stacking; exec $notify "stacking windows"
bindsym $mod+w layout tabbed; exec $notify "tabbing windows"
bindsym $mod+e layout toggle split; exec $notify "splitting windows"

bindsym $mod+f           fullscreen toggle
bindsym $mod+Shift+space floating toggle

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9

bindsym $mod+Ctrl+1 move container to workspace $ws1
bindsym $mod+Ctrl+2 move container to workspace $ws2
bindsym $mod+Ctrl+3 move container to workspace $ws3
bindsym $mod+Ctrl+4 move container to workspace $ws4
bindsym $mod+Ctrl+5 move container to workspace $ws5
bindsym $mod+Ctrl+6 move container to workspace $ws6
bindsym $mod+Ctrl+7 move container to workspace $ws7
bindsym $mod+Ctrl+8 move container to workspace $ws8
bindsym $mod+Ctrl+9 move container to workspace $ws9

bindsym $mod+Shift+1 move container to workspace $ws1; workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2; workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3; workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4; workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5; workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6; workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7; workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8; workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9; workspace $ws9

#
# --- menus ---
#

bindsym $mod+r mode "resize"
set $rs_amount 10
mode "resize" {
        bindsym h resize shrink width  $rs_amount px or $rs_amount ppt
        bindsym j resize grow   height $rs_amount px or $rs_amount ppt
        bindsym k resize shrink height $rs_amount px or $rs_amount ppt
        bindsym l resize grow   width  $rs_amount px or $rs_amount ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
}

set $mode_system (l)ock, (s)uspend, (h)ibernate, (r)eboot, (Shift+s)hutdown, reload (c)onfig, (e)xit
bindsym $mod+0 mode "$mode_system"
mode "$mode_system" {
    bindsym l       exec --no-startup-id $lock_cmd,             mode "default"
    bindsym s       exec --no-startup-id systemctl suspend,     mode "default"
    bindsym h       exec --no-startup-id systemctl hibernate,   mode "default"
    bindsym r       exec --no-startup-id systemctl reboot,      mode "default"
    bindsym Shift+s exec --no-startup-id systemctl poweroff,    mode "default"
    bindsym c       reload,                                     mode "default"
    bindsym e       exec --no-startup-id swaymsg exit,          mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+d mode "$mode_displays"
set $mode_displays set display mode: (1) one screen, (2) two screens, (3) HDMI, (4) t29
mode "$mode_displays" {
    bindsym 1       exec --no-startup-id "autorandr --load one",      mode "default"
    bindsym 2       exec --no-startup-id "autorandr --load two",      mode "default"
    bindsym 3       exec --no-startup-id "autorandr --load hdmi",     mode "default"
    bindsym 4       exec --no-startup-id "autorandr --load t29",      mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

set $screenshot (1) selection, (2) selection > clipboard, (3) whole screen
bindsym $mod+Shift+s mode "$screenshot"
mode "$screenshot" {
    bindsym 1 exec 'grim -g "$(slurp)" ~/Pictures/$(date +"%Y%m%d%H%M%S").png', mode "default"
    bindsym 2 exec 'grim -g "$(slurp)" - | wl-copy',                            mode "default"
    bindsym 3 exec 'grim ~/Pictures/$(date +"%Y%m%d%H%M%S").png',               mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}


#
# --- autostart ---
#

exec --no-startup-id dex --autostart --environment sway --search-paths ~/.config/autostart/
exec --no-startup-id /opt/Signal/signal-desktop --enable-features=UseOzonePlatform --ozone-platform=wayland
exec --no-startup-id /usr/bin/slack --enable-features=UseOzonePlatform --ozone-platform=wayland

