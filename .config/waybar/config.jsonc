{
    "layer": "top",
    "reload_style_on_change": true,
    "height": 24,
    "modules-left": ["niri/workspaces", "wlr/taskbar"],
    "modules-center": ["niri/window"],
    "modules-right": ["backlight", "battery", "clock", "tray"],

    "niri/workspaces": {
      "format": "{icon}"
    },
    "niri/window": {
    },
    "wlr/taskbar": {
      "icon-size": 12,
      "on-click": "activate",
      "on-click-middle": "close"
    },
    "battery": {
      "format": "{capacity}% {icon}",
      "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    },
    "backlight": {
      "device": "intel_backlight",
      "format": "{percent}% {icon}",
      "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "tray": {
      "spacing": 6,
      "show-passive-items": true
    }
}
