set imaginary-option "#123123"

set notification-error-bg       "#2c2d30" # bg
set notification-error-fg       "#be868c" # bright:red
set notification-warning-bg     "#2c2d30" # bg
set notification-warning-fg     "#ab916d" # bright:yellow
set notification-bg             "#2c2d30" # bg
set notification-fg             "#7f9d77" # bright:green

set completion-bg               "#363a3e" # bg2
set completion-fg               "#afb7c0" # fg
set completion-group-bg         "#363a3e" # bg1
set completion-group-fg         "#ab916d" # yellow
set completion-highlight-bg     "#759abd" # bright:blue
set completion-highlight-fg     "#363a3e" # bg2

# Define the color in index mode
set index-bg                    "#363a3e" # bg2
set index-fg                    "#afb7c0" # fg
set index-active-bg             "#759abd" # bright:blue
set index-active-fg             "#363a3e" # bg2

set inputbar-bg                 "#2c2d30" # bg
set inputbar-fg                 "#afb7c0" # fg

set statusbar-bg                "#363a3e" # bg2
set statusbar-fg                "#afb7c0" # fg

set highlight-active-color      "#a88cb3"
set highlight-color             "#5da19f"

set default-bg                  "#2c2d30" # bg
set default-fg                  "#afb7c0" # fg
set render-loading              true
set render-loading-bg           "#2c2d30" # bg
set render-loading-fg           "#afb7c0" # fg

# Recolor book content's color
set recolor-lightcolor          "#2c2d30" # bg
set recolor-darkcolor           "#afb7c0" # fg
set recolor                     "true"
# set recolor-keephue             true      # keep original color

